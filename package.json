{
  "name": "tartib",
  "version": "1.0.0",
  "private": true,
  "description": "Tartib \u2014 SMM content planner Telegram Mini App (NestJS + Prisma + Telegraf)",
  "scripts": {
    "build": "nest build",
    "build:web": "node tools/build.mjs",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "preview": "node tools/build.mjs && node tools/mock-server.mjs"
  },
  "dependencies": {
    "@nestjs/common": "^10.0.0",
    "@nestjs/config": "^3.0.0",
    "@nestjs/core": "^10.0.0",
    "@nestjs/platform-express": "^10.0.0",
    "@prisma/client": "5.22.0",
    "prisma": "5.22.0",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.8.1",
    "telegraf": "^4.16.3"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.0.0",
    "@nestjs/schematics": "^10.0.0",
    "@types/express": "^4.17.17",
    "@types/node": "^20.0.0",
    "esbuild": "0.23.1",
    "typescript": "^5.1.3"
  }
}
