# ── Telegram ──────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_bot_token_here
BOT_USERNAME=tartib_bot
# Mini App manzili (BotFather → Configure Mini App ham shu manzil)
WEBAPP_URL=https://tartib.example.uz/
# Webhook (bo'sh bo'lsa — polling, lokal ishlab chiqish uchun)
WEBHOOK_DOMAIN=https://tartib.example.uz
WEBHOOK_PATH=/webhook
# Telegram webhookni imzolaydi — tasodifiy uzun satr
WEBHOOK_SECRET=change_me_random_string

# ── Admin ─────────────────────────────────────────────────
# Sizning Telegram ID (@userinfobot) — narxlar, statistika, to'lovlarni tasdiqlash
ADMIN_TELEGRAM_ID=123456789
# Cheklar va murojaatlar keladigan chat (bo'sh = adminning o'zi)
ADMIN_GROUP_ID=
# Kunlik baza nusxasi yuboriladigan yopiq kanal (bot admin bo'lsin), ixtiyoriy
STORAGE_CHAT_ID=

# ── To'lov ────────────────────────────────────────────────
# BotFather → Payments (Click / Payme). Bo'sh bo'lsa: karta + chek (karta raqami admin paneldan kiritiladi)
PAYMENT_PROVIDER_TOKEN=

# ── AI ────────────────────────────────────────────────────
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ── Baza ──────────────────────────────────────────────────
POSTGRES_PASSWORD=tartib_pass
DATABASE_URL=postgresql://tartib_user:tartib_pass@db:5432/tartib

# ── Server / xotira ───────────────────────────────────────
PORT=4002
# javoblar keshi (RAM, MB) va qaysi RSS darajasida kesh yarmini bo'shatishi
CACHE_MAX_MB=64
RSS_SOFT_MB=350
# Toshkent vaqti (statistika kunlari uchun)
TZ_OFFSET_MIN=300

# Lokal sinov: brauzerda http://localhost:4002/?dev=1 (Telegramsiz). Production'da ishlamaydi.
# DEV_AUTH=1
